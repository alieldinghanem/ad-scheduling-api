# Optional runtime configuration
BACKEND_AI_DATA_URL=
BACKEND_FETCH_TIMEOUT_SECONDS=60
SCHEDULER_TIMEOUT_SECONDS=1200
SCHEDULER_JOB_WORKERS=1
MAX_COMPLETED_JOBS=8

# Optional shared key for ALL /schedule* routes. Set a strong random secret
# before connecting a real-data deployment to private institutional records.
# Requests must send: X-API-Key: <configured secret>
ADEX_API_KEY=

# Optional paths for runtime-generated files
# SCHEDULER_DATA_DIR=.
# LATEST_SCHEDULE_FILE=./latest_schedule.json
# GENERATION_STATUS_FILE=./latest_schedule_status.json
# LATEST_INPUT_FILE=./latest_input.json
